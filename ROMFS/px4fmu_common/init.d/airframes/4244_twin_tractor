#!/bin/sh
#
# @name Twin Tractor (Differential Thrust + Sun Tracker)
# @type Standard Plane
# @class Plane
#
# Hardware port of the 4244_jsbsim_twin_tractor SITL airframe. Same FW tuning and
# control allocation (CA_AIRFRAME 16 = differential-thrust fixed wing); only the
# simulator/output layer differs. The SITL-only failsafe relaxations and the
# wing_tilt_sim plant are intentionally omitted here.
#

. ${R}etc/init.d/rc.fw_defaults

param set-default FW_LND_ANG 3

param set-default NPFG_PERIOD 12

# Rate-loop gains. PX4's FW rate gains are normalized surface deflection per rad/s, so they
# do not scale with inertia: control moment per deflection shrinks with airframe size about as
# fast as inertia does. The previous values (P 0.015-0.037, FF 0.005-0.02) had been divided by
# the inertia ratio from the old Rascal placeholder, ~20x below PX4 defaults; in Stabilized a
# full stick then commanded only ~3% surface travel (surfaces looked dead on the bench).
#
# FF set from measured stick->rate authority in Manual (flight 214, 2026-08-28):
# roll ~103 deg/s per full deflection -> 1/1.80 = 0.56; pitch ~152 deg/s @ 20 m/s -> 0.38.
# P/I are PX4 defaults. Yaw has no flight data yet; defaults. Refine with FW autotune.
param set-default FW_PR_P 0.08
param set-default FW_PR_FF 0.4
param set-default FW_PR_I 0.1
param set-default TRIM_PITCH 0

param set-default FW_RR_FF 0.5
param set-default FW_RR_P 0.05
param set-default FW_RR_I 0.1

param set-default FW_R_RMAX 56.15

param set-default FW_YR_FF 0.3
param set-default FW_YR_P 0.05
param set-default FW_YR_I 0.1

param set-default FW_PSP_OFF 0
param set-default FW_P_LIM_MIN -15

param set-default FW_T_CLMB_MAX 5
param set-default FW_T_SINK_MAX 3.5
param set-default FW_T_SINK_MIN 3

# Airspeed envelope matched to how this airframe actually flies. The previous
# defaults (TRIM 15 / MAX 20) were ~2x below the real glide speed (~27-30 m/s
# observed at idle), so TECS saw a permanent overspeed, zeroed throttle and held
# max sink -> the loiter would not hold altitude.
param set-default FW_AIRSPD_TRIM 22
param set-default FW_AIRSPD_MAX 35
param set-default FW_AIRSPD_MIN 13

param set-default FW_W_EN 1

param set-default FD_ESCS_EN 0

param set-default MIS_TAKEOFF_ALT 50

param set-default NAV_ACC_RAD 15

param set-default RWTO_TKOFF 1

param set-default COM_PREARM_MODE 2

# Control allocation: fixed-wing with differential-thrust yaw, 2 motors.
# CA_AIRFRAME 16 selects ActuatorEffectivenessFixedWingDiffThrust, which enables
# yaw-by-differential-thrust on the ground (and on gear-switch override in air)
# and disables it once airborne. Tune CA_DTHR_SC to scale the yaw authority.
param set-default CA_AIRFRAME 16

param set-default CA_ROTOR_COUNT 2
param set-default CA_ROTOR0_PX 0.3
param set-default CA_ROTOR0_PY -0.25
param set-default CA_ROTOR1_PX 0.3
param set-default CA_ROTOR1_PY 0.25

# 4 control surfaces: 2 ailerons + 2 V-tail (custom type for explicit mixing)
param set-default CA_SV_CS_COUNT 4
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS2_TYPE 0
param set-default CA_SV_CS2_TRQ_P 0.5
param set-default CA_SV_CS2_TRQ_Y 0.5
param set-default CA_SV_CS3_TYPE 0
param set-default CA_SV_CS3_TRQ_P 0.5
param set-default CA_SV_CS3_TRQ_Y -0.5

# Output mapping on the FMU main PWM rail:
#   Motor1 -> MAIN1, Motor2 -> MAIN2, Servo1..4 (CS0..CS3) -> MAIN3..6
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 201
param set-default PWM_MAIN_FUNC4 202
param set-default PWM_MAIN_FUNC5 203
param set-default PWM_MAIN_FUNC6 204

# Motor min PWM at the ESC zero-throttle level (same as PWM_MAIN_DIS1/2): throttle 0 must not
# spin the props — the self_right maneuver holds throttle 0 while the wing rotates through the
# prop arc, and in flight idle throttle stops the props for the soaring profile.
param set-default PWM_MAIN_MIN1 1000
param set-default PWM_MAIN_MIN2 1000

# Sun-tracking tilt wing: dedicated reversible-ESC output on the FMU rail (FMU7)
# via Peripheral_via_Actuator_Set1. The sun_tracker module drives it with
# vehicle_command/DO_SET_ACTUATOR (param1 -> Set1). Configure the output so the
# reversible ESC reads center = neutral and +/-1 = full forward/reverse.
param set-default PWM_AUX_FUNC7 301

# Hold the tilt ESC at neutral (1500us) when the output is not live: PWM_AUX_DIS7
# applies while fully disarmed/not-prearmed, and PWM_AUX_FAIL7 on flight termination.
# When prearmed/armed the sun_tracker command drives FMU7 directly; at rest (u=0) the
# symmetric MIN/MAX (1000/2000) already maps to 1500, so the wing stays put.
param set-default PWM_AUX_DIS7 1500
param set-default PWM_AUX_FAIL7 1500

# Reverse the sun-derived tilt direction to match this airframe's wing/encoder mounting:
# the geometry convention (+tilt = panel normal toward +body-X / nose) is opposite the encoder's
# physical positive direction, so without this the wing tilts the right amount the wrong way.
param set-default SUN_TILT_REV 1

# Sun-tracking is opt-in: enable with SUN_TRK_EN once the encoder/ESC are wired.
param set-default SUN_TRK_EN 0

# Sun tracker startup. 'as5600' is the AS5600 wing-angle encoder on external I2C bus 4
# (-X external, -b 4 bus number). 'sun_tracker' gates on valid attitude/GPS/encoder data
# until SUN_TRK_EN is set.
wing_tilt start
as5600 start -X -b 4
sun_tracker start

# Autonomous self-righting (props-only inverted recovery), sharing the tilt-wing actuator/encoder.
# The SELF_RIGHT flight mode is gated so it can only be entered/armed when the estimator reports the
# aircraft inverted and at rest. Opt-in via SR_EN. Selectable on RC flight-mode slot 6 and via GCS.
param set-default SR_EN 0
param set-default SR_TILT_SP -1.57
param set-default COM_FLTMODE6 17
self_right start

# Battery charging monitor: INA226 on the charge path, external I2C bus 4 (shared with
# the AS5600 encoder; INA226 is 0x40-0x4F, AS5600 is fixed 0x36, so no address conflict).
# Publishes to the battery_charging uORB topic, separate from battery_status.
# NOTE: -a 0x40 is the common breakout default; change it to match your strapped address.
# -k keeps the driver retrying if the INA226 is not yet powered.
ina226_charger start -X -b 4 -a 0x40 -k

# Companion-computer float/fly autonomy (ahab-companion on a Raspberry Pi over Ethernet).
# uXRCE-DDS client over the network (CFG 1000 = Ethernet); the agent runs on the Pi
# (MicroXRCEAgent udp4 -p 8888). Set UXRCE_DDS_AG_IP to the Pi's address (int32 form) and
# the FC's own address in /fs/microsd/net.cfg before use.
param set-default UXRCE_DDS_CFG 1000
param set-default UXRCE_DDS_PRT 8888

# FLOAT while flying = RTL into the survey mission's landing pattern (DO_LAND_START + land items).
param set-default RTL_TYPE 1

# Log from boot so FLOAT decisions made while disarmed appear in the ULog.
param set-default SDLOG_MODE 1
