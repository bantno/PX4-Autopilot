#!/bin/sh
#
# @name Gazebo Twin Tractor Seaplane (AHAB)
# @type Fixedwing
#
# Gazebo model of AHAB: Tools/simulation/ahab_model/twin_tractor_seaplane (generated by
# Tools/simulation/ahab_model/tools/build_model.py). Same tuning, allocation and tilt-wing /
# self-right setup as the hardware airframe init.d/airframes/4244_twin_tractor; only the
# simulator/output layer differs (SIM_GZ_* instead of PWM_*).
#

. ${R}etc/init.d/rc.fw_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=twin_tractor_seaplane}

param set-default SIM_GZ_EN 1

# No pitot on the model (the real one was not running on the 2026-10-07 flights either):
# airspeed comes from the simulated sensor module.
param set-default SENS_EN_ARSPDSIM 1

# Wing-tilt encoder from the model's wing_tilt_joint (stands in for the AS5600)
param set-default SIM_GZ_EN_TILT 1

# Fixed-wing tuning: as the hardware airframe (4244_twin_tractor)
param set-default FW_LND_ANG 3

param set-default NPFG_PERIOD 12

param set-default FW_PR_P 0.08
param set-default FW_PR_FF 0.4
param set-default FW_PR_I 0.1
param set-default TRIM_PITCH 0

param set-default FW_RR_FF 0.5
param set-default FW_RR_P 0.05
param set-default FW_RR_I 0.1

param set-default FW_R_RMAX 56.15

param set-default FW_YR_FF 0.3
param set-default FW_YR_P 0.05
param set-default FW_YR_I 0.1

param set-default FW_PSP_OFF 0
param set-default FW_P_LIM_MIN -15

param set-default FW_T_CLMB_MAX 5
param set-default FW_T_SINK_MAX 3.5
param set-default FW_T_SINK_MIN 3

param set-default FW_AIRSPD_TRIM 22
param set-default FW_AIRSPD_MAX 35
param set-default FW_AIRSPD_MIN 13

param set-default FW_W_EN 1

param set-default FD_ESCS_EN 0

param set-default MIS_TAKEOFF_ALT 30

param set-default NAV_ACC_RAD 15
param set-default NAV_DLL_ACT 2

param set-default RWTO_TKOFF 1

param set-default COM_PREARM_MODE 2

# Control allocation: fixed-wing with differential-thrust yaw on the ground (as the hardware).
# Rotor positions relative to the CG (FRD), from the motor pads measured on Nick's mesh
# (x 0.092, y +-0.2373 in the model frame) and the canonical CG (0.445 m aft of the nose).
param set-default CA_AIRFRAME 16
param set-default CA_DTHR_SC 0.1

param set-default CA_ROTOR_COUNT 2
param set-default CA_ROTOR0_PX 0.054
param set-default CA_ROTOR0_PY -0.237
param set-default CA_ROTOR1_PX 0.054
param set-default CA_ROTOR1_PY 0.237

# 4 control surfaces: 2 ailerons + 2 V-tail (custom type for explicit mixing)
param set-default CA_SV_CS_COUNT 4
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS2_TYPE 0
param set-default CA_SV_CS2_TRQ_P 0.5
param set-default CA_SV_CS2_TRQ_Y 0.5
param set-default CA_SV_CS3_TYPE 0
param set-default CA_SV_CS3_TRQ_P 0.5
param set-default CA_SV_CS3_TRQ_Y -0.5

# Motors: rotor_0 (left) and rotor_1 (right), command in rad/s (17.3 kRPM = 1811 rad/s full throttle)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MAX1 1811
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MAX2 1811

# Control surfaces servo_0..3 (left/right aileron, left/right ruddervator), +-30 deg = joint limits
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_MAXA1 30
param set-default SIM_GZ_SV_MINA1 -30
param set-default SIM_GZ_SV_MAXA2 30
param set-default SIM_GZ_SV_MINA2 -30
param set-default SIM_GZ_SV_MAXA3 30
param set-default SIM_GZ_SV_MINA3 -30
param set-default SIM_GZ_SV_MAXA4 30
param set-default SIM_GZ_SV_MINA4 -30

# Tilt wing: wing_tilt's DO_SET_ACTUATOR -> Peripheral_via_Actuator_Set1 -> servo_4. The model's
# JointController treats the value as a joint velocity, so +-1 command = +-65 deg/s (bench: 60-70 deg/s
# at full command) and 0 = hold: a rate plant like the real reversible ESC.
param set-default SIM_GZ_SV_FUNC5 301
param set-default SIM_GZ_SV_MAXA5 65
param set-default SIM_GZ_SV_MINA5 -65

# No ESC power-on arming sequence in simulation
param set-default TILT_ARM_V 0

param set-default SUN_TILT_REV 1
param set-default SUN_TRK_EN 0

wing_tilt start
sun_tracker start

param set-default SR_EN 0
param set-default SR_TILT_SP -1.57
param set-default COM_FLTMODE6 17

self_right start
