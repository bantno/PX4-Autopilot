    <!-- wing tilt: rate plant. PX4 function 301 (wing_tilt's DO_SET_ACTUATOR) -> servo_4, scaled by
         SIM_GZ_SV_MIN/MAXA5 to +/- full-command rate (deg/s) and applied here as a joint velocity -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wing_tilt_joint</joint_name>
      <sub_topic>servo_4</sub_topic>
      <initial_velocity>0</initial_velocity>
    </plugin>
    <!-- hull hydrodynamics on the water (PX4 gz plugin, src/modules/simulation/gz_plugins/water_hydrodynamics):
         per-panel pressure drag / suction / viscous drag (Kerner 2015, as in asv_wave_sim), built from the box
         collisions; buoyancy comes from the world's graded Buoyancy system. Nothing is applied out of the water. -->
    <plugin filename="libWaterHydrodynamicsPlugin.so" name="water_hydrodynamics::WaterHydrodynamics">
      <panels_file>model://twin_tractor_seaplane/hydro_panels.txt</panels_file>
      <water_level>0</water_level>
      <waterline_band>0.01</waterline_band>
      <panel_size>0.025</panel_size>
      <hull_length>1.13</hull_length>
      <cPDrag1>100</cPDrag1>
      <cPDrag2>100</cPDrag2>
      <fPDrag>1</fPDrag>
      <cSDrag1>20</cSDrag1>
      <cSDrag2>20</cSDrag2>
      <fSDrag>1</fSDrag>
      <vRDrag>1</vRDrag>
      <cDampL1>1</cDampL1>
      <cDampL2>1</cDampL2>
      <cDampR1>20</cDampR1>
      <cDampR2>2</cDampR2>
      <max_force>500</max_force>
      <max_torque>100</max_torque>
    </plugin>
    <!-- wing angle feedback -> gz_bridge -> sensor_encoder (SIM_GZ_EN_TILT) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wing_tilt_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_0</joint_name>
      <sub_topic>servo_0</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>8</cmd_max>
      <cmd_min>-8</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_1</joint_name>
      <sub_topic>servo_1</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>8</cmd_max>
      <cmd_min>-8</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_2</joint_name>
      <sub_topic>servo_2</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
